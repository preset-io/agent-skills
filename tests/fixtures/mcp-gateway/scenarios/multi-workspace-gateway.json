      "args": {
        "workspace_id": "123",
        "query": "list_databases",
        "limit": 5
      },
      "expect": {
        "isError": false,
        "contains": "inputSchema"
      }
    },
    {
      "call": "call_tool",
      "args": {
        "workspace_id": "123",
        "tool_name": "list_databases",
        "args": {
          "request": {
            "page": 1,
            "page_size": 5
          }
        }
      },
      "expect": {
