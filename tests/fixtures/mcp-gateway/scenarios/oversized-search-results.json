{
  "id": "oversized-search-results",
  "surface": "gateway",
  "environment": "production",
  "description": "A broad search omits an oversized definition; the agent fetches it alone with limit=1 and its offset before calling.",
  "environments": {
    "production": {
      "scopes": [
        "superset:read",
        "superset:sqllab:write"
      ],
      "workspaces": [
        {
          "id": 123,
          "name": "a1b2c3d4",
          "title": "Sales analytics",
          "services": [
            "workspace_tools"
          ],
          "catalog": false,
          "tools": [
            {
              "name": "list_databases",
              "description": "list databases",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "request": {
                    "type": "object"
                  }
                },
                "required": [
                  "request"
                ]
              },
              "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false
              },
              "oversized": true
            },
            {
              "name": "list_dashboards",
              "description": "list dashboards",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "request": {
                    "type": "object"
                  }
                },
                "required": [
                  "request"
                ]
              },
              "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false
              }
            }
          ]
        }
      ]
    }
  },
  "expectViolations": [],
  "steps": [
    {
      "call": "list_workspaces",
      "args": {},
      "expect": {
        "isError": false
      }
    },
    {
      "call": "search_workspace_tools",
      "args": {
        "workspace_id": "123",
        "query": "list"
      },
      "expect": {
        "isError": false,
        "contains": "omitted"
      }
    },
    {
      "call": "search_workspace_tools",
      "args": {
        "workspace_id": "123",
        "query": "list",
        "limit": 1,
        "offset": 0
      },
      "expect": {
        "isError": false,
        "contains": "list_databases"
      }
    },
    {
      "call": "call_tool",
      "args": {
        "workspace_id": "123",
        "tool_name": "list_databases",
        "args": {
          "request": {
            "page": 1
          }
        }
      },
      "expect": {
        "isError": false
      }
    }
  ],
  "label": "mocked"
}
